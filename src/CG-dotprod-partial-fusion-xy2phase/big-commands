make clean

export JOB="gemv-xy2phase-$(date +%Y%m%d_%H%M%S)"
export WSE_SERVER="http://localhost:8080"

W=512
H=512
M=32
N=512
SX=23
SY=23

make build-run \
    ARCH=sdr \
    W="$W" H="$H" \
    M="$M" N="$N" \
    SX="$SX" SY="$SY" \
    WAIT_ALPHA=1 \
    INPUT_MODE=pattern

make wse-queue \
    WSE_JOB="$JOB" \
    WSE_SERVER="$WSE_SERVER" \
    WSE_WIDTH="$W" \
    WSE_HEIGHT="$H" \
    WSE_LIFETIME=500

echo "JOB=$JOB"

JOB="$JOB" \
WSE_SERVER="$WSE_SERVER" \
W="$W" H="$H" B="$M" RUNS=1 \
./run_5_timings.sh

column -s, -t out_hw/timing_5runs/results.csv

for trial in out_hw/*/trial_*; do
    [[ -f "$trial/result-root.bin" ]] || continue
    if python3 verify_dotprod.py "$trial" >"$trial/verification.txt" 2>&1; then
        echo "VALID:   $trial"
    else
        echo "INVALID: $trial"
    fi
done

%!ps

/min { 2 copy gt { exch } if pop } bind def
/max { 2 copy lt { exch } if pop } bind def
% height orientation tipu tipl arrow -
/arrow {
	4 dict begin
	/tl exch def
	/tu exch def
	/o exch def
	/h exch 4 div def
	gsave newpath
	9 20 div 9 20 div scale
	o 90 mul rotate
	h abs h moveto
	1 h lineto

	tu tl and { 1 h translate
            1 neg 5 div 1 5 div moveto
            0 0 lineto
            1 neg 5 div 1 neg 5 div lineto }
	{ tu { 1 h translate -1 5 div +1 5 div lineto } if
	  tl { 1 h translate -1 5 div -1 5 div lineto } if
	} ifelse

        stroke
        grestore
	end
} def

/cross {
	gsave newpath
	9 20 div 9 20 div scale

	1 4 neg div dup moveto
	1 4 div dup lineto
	1 4 div dup neg moveto
	1 4 div dup neg exch lineto

	stroke
	grestore
} def

% x y r box -
/box {
	3 dict begin
	/r exch def
	/y exch def
	/x exch def
	gsave newpath
	x y translate
	45 rotate
	r neg r neg moveto
	r neg r     lineto
	r     r     lineto
	r     r neg lineto
	closepath
	stroke
	grestore
	end
} def

% direction switch ramp -
/ramp {
	2 dict begin
	/s exch def
	/d exch def

	gsave newpath
	9 20 div 9 20 div scale

	s
	{ d { -1 4 div -1 4 div 1 6 div 0 360 arc fill }
            { +1 4 div +1 4 div 1 6 div box } ifelse } % cross switch
	{ d { 0 0 1 6 div 0 360 arc fill }
            { 45 rotate 0 0 1 4 div box } ifelse } % plain switch
	ifelse

	grestore
	end
} def

% str pat contains - bool
/contains {
	search
	{ pop pop pop true }
	{ pop false }
	ifelse
} def

% (a) (b) concat (ab)  
/concat {
	exch dup length    
	2 index length add string    
	dup dup 4 2 roll copy length
	4 -1 roll putinterval
} def

% src tgt port arrowhelper -
/arrowhelper {
	4 dict begin
	/port exch def
	/tgt exch def
	/src exch def
	/o exch def
	o tgt port contains dup src port contains not and
	% o 2 mod 0 eq { exch } if
        arrow
	end
} def

% x y str dx dy n subicon
/subicon {
	6 dict begin
	/n exch def
	/dy exch def
	/dx exch def
	/str exch def
	/y exch def
	/x exch def

	gsave
	1 n div dup scale
	x n mul dx add
	y 1 add n mul dy add
	str
	icon
	grestore

	end
} def

% x y str icon -
/icon {
	8 dict begin
	/s exch def
	/y exch def
	/x exch def
	gsave
	x 0.5 add y 0.5 sub translate

	[ s (X) search /switch exch def ]
	[ s (>) search /plain exch def ]

	switch plain xor not { quit } if

	switch { exch } if

	aload pop      % expand matching array
	/src exch def  % source ports
	pop            % matched keyword
	/tgt exch def  % target ports
	pop            % failed match array

	plain
	{
		src tgt concat /port exch def

		port (R) contains { 0 0 src tgt (R) arrowhelper } if
		port (U) contains { 0 1 src tgt (U) arrowhelper } if
		port (L) contains { 0 2 src tgt (L) arrowhelper } if
		port (D) contains { 0 3 src tgt (D) arrowhelper } if
		src (C) contains { false false ramp } if
		tgt (C) contains { true false ramp } if
	}
	{
		src (r) contains { -1 0 false false arrow } if
		src (u) contains { +1 1 false false arrow } if
		src (l) contains { -1 2 false false arrow } if
		src (d) contains { +1 3 false false arrow } if
		%src (c) contains { false true ramp } if

		src (R) contains { +1 0 false false arrow } if
		src (U) contains { -1 1 false false arrow } if
		src (L) contains { +1 2 false false arrow } if
		src (D) contains { -1 3 false false arrow } if
		src (C) contains { false true ramp } if

		tgt (R) contains { +1 0 true true arrow } if
		tgt (U) contains { -1 1 true true arrow } if
		tgt (L) contains { +1 2 true true arrow } if
		tgt (D) contains { -1 3 true true arrow } if
		tgt (C) contains { true true ramp } if
		cross
	}
	ifelse
	
	grestore
	end
} def

% x y w h name color rect -
/rect {
	6 dict begin
	/color exch def
	/name exch def
	/h exch def
	/w exch def
	/y exch def
	/x exch def

	gsave
	x y moveto
	w 0 rlineto
	0 h rlineto
	w neg 0 rlineto
	closepath
	color nrect div 0.1 1 sethsbcolor
	fill
	%x y translate
	% w h grid
	grestore
	
	gsave
	newpath
	x y moveto
	w 0 rlineto
	0 h rlineto
	w neg 0 rlineto
	closepath
	stroke

	x y translate
	0 0 moveto

	% w h mul lt { -90 rotate } if

	currentfont
	name true charpath pathbbox
	3 -1 roll sub dup /hh exch def h exch div
	3  1 roll exch sub w exch div
	min 0.8 mul dup /xfactor exch def scalefont
	setfont newpath
	name stringwidth pop 
	2 div neg w 2 div add 0 moveto name show
	stroke

	grestore
	end
} def

% w h grid -
/grid {
	2 dict begin
	/h exch def
	/w exch def
	gsave

	1 40 div setlinewidth
	0.9 0.9 1.0 setrgbcolor

	0 1 w { newpath 0 moveto 0 h rlineto stroke } for
	0 1 h { newpath 0 exch moveto w 0 rlineto stroke } for

	grestore
	end
} def
1 setgray clippath fill
0 setgray

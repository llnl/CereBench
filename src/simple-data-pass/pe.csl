param memcpy_params;
param pe_x: i16;
param width: i16;
param c_east: color;
param tensor_size: i16; 

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// create a 1D tensor sized exactly to the parameter passed by the compiler
var data_buffer = @zeros([tensor_size]f32);
var ptr_data: [*]f32 = &data_buffer;

// memory dsd to access local array
const mem_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &data_buffer, .extent = tensor_size });


// fabric queues and dsd
const iq_west = @get_input_queue(2);
const oq_east = @get_output_queue(3);

const in_dsd_west  = @get_dsd(fabin_dsd,  .{ .extent = tensor_size, .input_queue = iq_west });
const out_dsd_east = @get_dsd(fabout_dsd, .{ .extent = tensor_size, .output_queue = oq_east });


// chain Tasks
const exit_task_id: local_task_id = @get_local_task_id(9);

// runner Function
fn compute() void {
    if (pe_x == 0) {
        // left Edge: Just send our data East. When done, trigger exit
        @fmovs(out_dsd_east, mem_dsd, .{ .async = true, .activate = exit_task_id });
    } else {
        // everyone else: Wait for data from West, add it to our array. When done, trigger exit
        @fadds(mem_dsd, mem_dsd, in_dsd_west, .{ .async = true, .activate = exit_task_id });
    }
}

task exit_task() void {
    // safely unblock the Python script
    sys_mod.unblock_cmd_stream();
}


// BOOTSTRAP 
comptime {
    // only initialize the input queue if we aren't the leftmost PE
    if (pe_x > 0) {
        @initialize_queue(iq_west, .{ .color = c_east });
    }
    // only initialize the output queue if we aren't the rightmost PE
    if (pe_x < width - 1) {
        @initialize_queue(oq_east, .{ .color = c_east });
    }
    
    // bind tasks and export symbols
    @bind_local_task(exit_task, exit_task_id);
    @export_symbol(ptr_data, "data_buffer");
    @export_symbol(compute);
}
